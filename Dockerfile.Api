# syntax=docker/dockerfile:1
# Two images from one build:
#   default target  -> the API server image (unchanged behaviour)
#   --target squid  -> the all-in-one image: API + bundled web UI + optional built-in PostgreSQL /
#                      Redis + first-run setup. Needs the SquidWeb sources as a named context:
#
#   docker buildx build -f Dockerfile.Api --target squid --build-context squidweb=../SquidWeb -t squid:local .
#
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:9.0 AS build
ARG TARGETARCH

WORKDIR /src
COPY NuGet.Config .
COPY src/Squid.Message/ Squid.Message/
COPY src/Squid.Core/ Squid.Core/
COPY src/Squid.Api/ Squid.Api/
COPY src/Squid.Calamari/ Squid.Calamari/

RUN dotnet publish Squid.Api/Squid.Api.csproj -c Release -o /app
RUN if [ "$TARGETARCH" = "amd64" ]; then RID="linux-x64"; else RID="linux-$TARGETARCH"; fi && \
    dotnet publish Squid.Calamari/Squid.Calamari.csproj -c Release -r $RID --self-contained -o /calamari && \
    chmod +x /calamari/squid-calamari

# Download kubectl matching target architecture
RUN KUBECTL_VERSION=$(curl -L -s https://dl.k8s.io/release/stable.txt) && \
    if [ "$TARGETARCH" = "amd64" ]; then KARCH="amd64"; else KARCH="$TARGETARCH"; fi && \
    curl -LO "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${KARCH}/kubectl" && \
    chmod +x kubectl && mv kubectl /usr/local/bin/kubectl

# Download helm matching target architecture. The version is pinned: asking the GitHub API for "latest" is unauthenticated, so a rate-limited
# runner got 403, an empty version and a failed build. Raise it here (or with --build-arg HELM_VERSION=...) when upgrading.
ARG HELM_VERSION=v4.3.2
RUN if [ "$TARGETARCH" = "amd64" ]; then HARCH="amd64"; else HARCH="$TARGETARCH"; fi && \
    curl -fsSL https://get.helm.sh/helm-${HELM_VERSION}-linux-${HARCH}.tar.gz | tar xz && \
    mv linux-${HARCH}/helm /usr/local/bin/helm && \
    chmod +x /usr/local/bin/helm && \
    rm -rf linux-${HARCH}

# Download AWS CLI v2 matching target architecture
RUN apt-get update && apt-get install -y --no-install-recommends unzip && rm -rf /var/lib/apt/lists/* && \
    if [ "$TARGETARCH" = "amd64" ]; then AWSARCH="x86_64"; else AWSARCH="aarch64"; fi && \
    curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-${AWSARCH}.zip" -o /tmp/awscliv2.zip && \
    unzip -q /tmp/awscliv2.zip -d /tmp && \
    /tmp/aws/install --install-dir /opt/aws-cli --bin-dir /opt/aws-cli/bin && \
    rm -rf /tmp/awscliv2.zip /tmp/aws

# Install dotnet-script global tool (for C# scripting)
RUN dotnet tool install -g dotnet-script

# Download PowerShell matching target architecture. Pinned for the same reason as helm (raise it here or with --build-arg PWSH_VERSION=...).
ARG PWSH_VERSION=7.7.0
RUN if [ "$TARGETARCH" = "amd64" ]; then PARCH="x64"; else PARCH="$TARGETARCH"; fi && \
    mkdir -p /opt/powershell && \
    curl -fsSL "https://github.com/PowerShell/PowerShell/releases/download/v${PWSH_VERSION}/powershell-${PWSH_VERSION}-linux-${PARCH}.tar.gz" | tar xz -C /opt/powershell && \
    chmod +x /opt/powershell/pwsh

# Runtime
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS api

RUN apt-get update && apt-get install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /app .
COPY --from=build /calamari/ /squid/bin/
COPY --from=build /usr/local/bin/kubectl /usr/local/bin/kubectl
COPY --from=build /usr/local/bin/helm /usr/local/bin/helm
COPY --from=build /opt/aws-cli /opt/aws-cli
COPY --from=build /opt/powershell /opt/powershell
COPY --from=build /usr/share/dotnet/sdk /usr/share/dotnet/sdk
COPY --from=build /root/.dotnet/tools /root/.dotnet/tools
ENV PATH="/root/.dotnet/tools:/opt/powershell:/opt/aws-cli/bin:${PATH}"

EXPOSE 8080
EXPOSE 443
EXPOSE 10943

ENTRYPOINT ["dotnet", "Squid.Api.dll"]

# ── All-in-one: web UI (arch-independent output, built on the build platform) ──
FROM --platform=$BUILDPLATFORM node:20-alpine AS web
WORKDIR /web
RUN apk add --no-cache git
COPY --from=squidweb package.json ./
COPY --from=squidweb package-lock.json* pnpm-lock.yaml* ./
RUN npm install --force
COPY --from=squidweb . .
RUN rm -rf dist node_modules/.vite && npm run build
# Same-origin build: empty base URLs make the UI call the server that served it.
RUN VITE_API_BASE_URL= VITE_AUTH_BASE_URL= npx -y @import-meta-env/cli@0.7.4 -x .env.example -p dist/index.html

# ── All-in-one image ──
FROM api AS squid

# Built-in database / cache (only started when chosen) + tini as PID 1 so the daemonised
# postgres / redis children are reaped. No default cluster: Squid initialises its own in /data.
# The postgres account gets a FIXED uid/gid so a cluster in /data stays owned by it across image
# rebuilds (package install order would otherwise decide the uid).
RUN groupadd --system --gid 999 postgres \
    && useradd --system --uid 999 --gid 999 --home-dir /var/lib/postgresql --shell /bin/bash postgres \
    && mkdir -p /etc/postgresql-common \
    && echo 'create_main_cluster = false' > /etc/postgresql-common/createcluster.conf \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql redis-server tini \
    && rm -rf /var/lib/apt/lists/*

COPY --from=web /web/dist /app/wwwroot
COPY docker/squid/appsettings.json /app/appsettings.json
COPY docker/squid/entrypoint.sh /usr/local/bin/squid-entrypoint

ENV ASPNETCORE_HTTP_PORTS=8080

VOLUME /data
EXPOSE 8080 10943

HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=4 \
    CMD bash -c 'exec 3<>/dev/tcp/127.0.0.1/8080 && printf "GET /api/setup/status HTTP/1.0\r\n\r\n" >&3 && grep -q "200 OK" <&3'

ENTRYPOINT ["tini", "--", "squid-entrypoint"]
CMD ["dotnet", "Squid.Api.dll"]

# ── Default target: the API image, exactly as before ──
FROM api
